{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thuminal",
  "version": "0.1.2",
  "identifier": "dev.thuminal.app",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "thuminal",
        "width": 1400,
        "height": 900,
        "minWidth": 600,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: thuminal-file:; media-src 'self' blob: thuminal-file:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1430"
    }
  },
  "bundle": {
    "macOS": {
      "signingIdentity": "-"
    },
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/thuminald",
      "binaries/thuminal"
    ],
    "resources": {
      "../../../plugins/claude-code/thuminal/": "claude-plugin/",
      "../../web/dist/": "web/"
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown",
        "contentTypes": [
          "net.daringfireball.markdown"
        ],
        "mimeType": "text/markdown",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "json"
        ],
        "name": "JSON",
        "contentTypes": [
          "public.json"
        ],
        "mimeType": "application/json",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text",
        "mimeType": "text/plain",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "yaml",
          "yml"
        ],
        "name": "YAML",
        "contentTypes": [
          "public.yaml"
        ],
        "mimeType": "application/yaml",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "toml"
        ],
        "name": "TOML",
        "mimeType": "application/toml",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "ext": [
          "log"
        ],
        "name": "Log",
        "contentTypes": [
          "com.apple.log"
        ],
        "mimeType": "text/x-log",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "opener": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5QzBGNTcxNDNCNTBDNjEKUldSaERMVkRjZlhBaWFsRWY3d3ZEMlVEVit0VHd3cmFZZC9SOWtkT1dpTStuamVGU1pBYk1jaVYK",
      "endpoints": [
        "https://github.com/whquddn55/thuminal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
