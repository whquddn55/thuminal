{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "thuminal",
  "version": "0.1.0",
  "identifier": "dev.thuminal.app",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "thuminal",
        "width": 1400,
        "height": 900,
        "minWidth": 600,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: thuminal-file:; media-src 'self' blob: thuminal-file:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1430"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/thuminald",
      "binaries/thuminal"
    ],
    "resources": {
      "../../../plugins/claude-code/thuminal/": "claude-plugin/",
      "../../web/dist/": "web/"
    }
  }
}